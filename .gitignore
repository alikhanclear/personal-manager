# ============================================================================
# CasualHero BI Platform - Git Ignore
# ============================================================================

# ============================================================================
# SENSITIVE DATA - NEVER COMMIT
# ============================================================================

# Environment variables (contains database credentials)
.env
.env.local
.env.*.local

# Database credentials
credentials.json
secrets.json
*.pem
*.key

# AWS credentials
.aws/
aws-credentials.json

# ============================================================================
# Python
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
venv/
env/
ENV/
.venv

# Miniconda
conda-meta/
.conda/

# ============================================================================
# IDEs and Editors
# ============================================================================

# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Jupyter Notebook
.ipynb_checkpoints

# Spyder
.spyderproject
.spyproject

# ============================================================================
# Streamlit
# ============================================================================

# Streamlit cache
.streamlit/
streamlit_cache/

# ============================================================================
# Data Files (Large or Sensitive)
# ============================================================================

# CSV exports with real data
data/*.csv
exports/*.csv
backup/*.csv

# Database dumps
*.sql
*.dump
*.backup

# Parquet files (can be large)
data/*.parquet

# ============================================================================
# Logs
# ============================================================================

logs/
*.log
*.log.*

# ============================================================================
# OS Generated
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================================================
# Docker
# ============================================================================

# Docker volumes
docker-compose.override.yml
.docker/

# ============================================================================
# Temporary Files
# ============================================================================

tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ============================================================================
# KEEP THESE FILES (Exceptions)
# ============================================================================

# Keep example/template files
!.env.example
!config/fiscal_overrides.yaml
!README.md
!requirements.txt

# Keep test data (small, anonymized)
!tests/fixtures/*.csv
!tests/fixtures/*.json

# ============================================================================
# Project-Specific
# ============================================================================

# Local development database
casualhero.db
*.sqlite
*.sqlite3

# Cache directories
.cache/
__pycache__/

# Documentation builds
docs/_build/
docs/.doctrees/

# ============================================================================
