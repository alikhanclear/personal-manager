# Personal Manager - Environment Variables
# Copy this file to .env and fill in your actual values

# Application Root Directory (optional, for external scripts)
APP_ROOT_DIR=C:\Users\azimu\Documents\016. Personal Manager\personal-manager

# Anthropic API Key (for AI categorization)
# Get your key from: https://console.anthropic.com/
# Leave blank to use rules-only mode (no AI)
ANTHROPIC_API_KEY=

# Database Path (optional, defaults to data/finance.db)
# DB_PATH=data/finance.db

# App Configuration (optional)
# DEBUG=True
# HOST=0.0.0.0
# PORT=8050
