# ============================================================================
# CasualHero BI Platform - Environment Variables
# ============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to git (already in .gitignore)
#
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# --------------------------------------------------------------------------
# OPTION 1: Use DATABASE_URL (RECOMMENDED)
# --------------------------------------------------------------------------
# Full PostgreSQL connection string
# Choose AWS (Phase 1) or Neon (Phase 3) configuration below

# Phase 1: AWS PostgreSQL (Materialized View)
# DATABASE_URL=postgresql://username:password@aws-host.region.rds.amazonaws.com:5432/dbname

# Phase 3: Neon Serverless PostgreSQL (Future)
# DATABASE_URL=postgresql://username:password@neon-host.neon.tech:5432/dbname?sslmode=require

DATABASE_URL=

# --------------------------------------------------------------------------
# OPTION 2: Use Individual Components (Alternative)
# --------------------------------------------------------------------------
# If DATABASE_URL is not set, these will be used to build the connection string

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=casualhero
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# --------------------------------------------------------------------------
# Connection Pool Settings (Optional)
# --------------------------------------------------------------------------
# Adjust based on expected load and database limits

DB_POOL_SIZE=10                # Number of connections to keep in pool
DB_MAX_OVERFLOW=20             # Max additional connections above pool_size
DB_POOL_TIMEOUT=30             # Seconds to wait for connection from pool
DB_POOL_RECYCLE=3600           # Recycle connections after 1 hour

# --------------------------------------------------------------------------
# SSL/TLS Settings
# --------------------------------------------------------------------------
# IMPORTANT: AWS RDS and Neon both require SSL

DB_SSL_ENABLED=true            # Enable SSL (required for AWS and Neon)
DB_SSL_MODE=require            # SSL mode: require | verify-ca | verify-full

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Development vs Production
DEBUG=false                    # Set to true for development
ENVIRONMENT=production         # development | staging | production

# Streamlit Cache TTL (seconds)
CACHE_TTL=300                  # 5 minutes

# ============================================================================
# MATERIALIZED VIEW CONFIGURATION (Phase 1)
# ============================================================================

# Name of the materialized view in AWS PostgreSQL
MV_NAME=orders_view            # Replace with actual view name from client

# Refresh schedule (for documentation - refresh happens in database)
# MV_REFRESH_SCHEDULE=daily_at_6am

# ============================================================================
# FISCAL CALENDAR (Optional Overrides)
# ============================================================================

# Fiscal calendar is configured in config/fiscal_overrides.yaml
# These env vars are for runtime overrides if needed (rare)

# FISCAL_CUTOFF_HOUR=7          # 7AM cutoff (default: 7)

# ============================================================================
# DEPLOYMENT SETTINGS (Fly.io)
# ============================================================================

# Fly.io deployment (Phase 2)
# FLY_APP_NAME=casualhero-bi
# FLY_REGION=lhr                # London region

# ============================================================================
# MONITORING & LOGGING (Future)
# ============================================================================

# Sentry for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Log level
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ============================================================================
# SECURITY (Production)
# ============================================================================

# Streamlit secrets (if using Streamlit Cloud)
# STREAMLIT_SECRET_KEY=your-secret-key-here

# ============================================================================
# NOTES
# ============================================================================
#
# AWS RDS Connection:
# - Ensure security group allows inbound traffic on port 5432
# - Use IAM authentication or username/password
# - SSL is required for RDS
#
# Neon Connection:
# - Always use sslmode=require in connection string
# - Connection string format: postgresql://user:pass@host.neon.tech/db?sslmode=require
# - Neon provides connection pooling by default
#
# Local Development:
# - Use docker-compose to run local PostgreSQL
# - Set DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casualhero
# - SSL not required for localhost
#
# ============================================================================
